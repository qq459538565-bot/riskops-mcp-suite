{
  "name": "Daily SEC 8-K Cyber Breach & Accounting Red-Flag Alert (Apify -> Slack)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 13 * * 1-5" }]
        }
      },
      "id": "cron-trigger",
      "name": "Every Weekday 13:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/durative_hairstreak~sec-8k-risk-signals/run-sync-get-dataset-items?token={{$env.APIFY_API_TOKEN}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"mode\": \"market_scan\",\n  \"riskItems\": [\"1.05\", \"4.01\", \"4.02\", \"1.03\", \"3.01\"],\n  \"lookbackDays\": 2,\n  \"maxResults\": 20,\n  \"includeExcerpts\": true,\n  \"minRiskScore\": 65\n}"
      },
      "id": "apify-call",
      "name": "Run SEC 8-K Risk Signals Actor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.riskScore }}",
              "operation": "largerEqual",
              "value2": 70
            }
          ]
        }
      },
      "id": "filter-red",
      "name": "Filter RED / HIGH Alerts (>=70)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "text": "=:rotating_light: *SEC 8-K Risk Alert* ({{ $json.riskTrafficLight }} {{ $json.riskScore }}/100)\n*Company:* {{ $json.companyName }} ({{ $json.ticker || 'N/A' }})\n*Filed:* {{ $json.filingDate }} | *Form:* {{ $json.formType }} | *Items:* {{ $json.matchedRiskItems.join(', ') }}\n*Red Flags:* {{ ($json.detectedRedFlags || []).join('; ') || 'None' }}\n*Filing:* {{ $json.filingUrl }}"
      },
      "id": "slack-alert",
      "name": "Post to Slack Risk Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1000, 260]
    }
  ],
  "connections": {
    "Every Weekday 13:00 UTC": {
      "main": [[{ "node": "Run SEC 8-K Risk Signals Actor", "type": "main", "index": 0 }]]
    },
    "Run SEC 8-K Risk Signals Actor": {
      "main": [[{ "node": "Filter RED / HIGH Alerts (>=70)", "type": "main", "index": 0 }]]
    },
    "Filter RED / HIGH Alerts (>=70)": {
      "main": [[{ "node": "Post to Slack Risk Channel", "type": "main", "index": 0 }]]
    }
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
